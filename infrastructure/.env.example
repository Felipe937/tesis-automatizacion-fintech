# =============================================================================
# .env.example — Variables de entorno para despliegue n8n Fintech Colombia
# Copia este archivo a .env y rellena todos los valores <REEMPLAZAR_...>
# Nunca commitear el .env real (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# DOMINIO Y TLS
# -----------------------------------------------------------------------------
DOMAIN_NAME=n8n.tudominio.com.co
LETSENCRYPT_EMAIL=admin@tudominio.com.co

# -----------------------------------------------------------------------------
# POSTGRESQL (red interna, no expuesto al host)
# -----------------------------------------------------------------------------
POSTGRES_DB=n8n_fintech
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=<REEMPLAZAR_CON_CONTRASENA_DE_32_CHARS>

# -----------------------------------------------------------------------------
# N8N
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<REEMPLAZAR_CON_CONTRASENA>
N8N_ENCRYPTION_KEY=<REEMPLAZAR_CON_HEX_DE_32_BYTES_64_CHARS>
N8N_CONCURRENCY=5
EXECUTIONS_DATA_MAX_AGE=90

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP para alertas y reportes de los workflows n8n)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.tudominio.com.co
SMTP_PORT=587
SMTP_USER=<REEMPLAZAR>
SMTP_PASS=<REEMPLAZAR>
SMTP_SENDER=alertas@tudominio.com.co

# Destinatario de los reportes y alertas (reporte semanal + dashboard)
ADMIN_EMAIL=admin@tudominio.com.co

# -----------------------------------------------------------------------------
# INTEGRACIÓN: HUBSPOT CRM — OAuth 2.0 (RF-011)
# Modo de autenticación: 'oauth2' (recomendado) | 'private_app'
# -----------------------------------------------------------------------------
HUBSPOT_AUTH_MODE=oauth2
# OAuth 2.0 (Authorization Code + Refresh Token) — app de HubSpot
HUBSPOT_CLIENT_ID=<REEMPLAZAR_CON_CLIENT_ID>
HUBSPOT_CLIENT_SECRET=<REEMPLAZAR_CON_CLIENT_SECRET>
HUBSPOT_REFRESH_TOKEN=<REEMPLAZAR_CON_REFRESH_TOKEN>
HUBSPOT_REDIRECT_URI=https://n8n.tudominio.com.co/rest/oauth2-credential/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write
# Private App Token (modo alternativo; NO cumple OAuth 2.0)
HUBSPOT_ACCESS_TOKEN=<REEMPLAZAR_CON_HUBSPOT_PRIVATE_APP_TOKEN>
HUBSPOT_PORTAL_ID=<REEMPLAZAR_CON_PORTAL_ID>

# -----------------------------------------------------------------------------
# INTEGRACIÓN: MAILCHIMP — OAuth 2.0 (RF-011)
# Modo de autenticación: 'oauth2' (recomendado) | 'api_key'
# -----------------------------------------------------------------------------
MAILCHIMP_AUTH_MODE=oauth2
# OAuth 2.0 (Authorization Code). El token de Mailchimp NO expira.
MAILCHIMP_CLIENT_ID=<REEMPLAZAR_CON_CLIENT_ID>
MAILCHIMP_CLIENT_SECRET=<REEMPLAZAR_CON_CLIENT_SECRET>
MAILCHIMP_OAUTH_CODE=<REEMPLAZAR_CON_OAUTH_CODE>
MAILCHIMP_REDIRECT_URI=https://n8n.tudominio.com.co/rest/oauth2-credential/callback
# Datacenter de Mailchimp (obligatorio en modo oauth2: ej. us21)
MAILCHIMP_SERVER_PREFIX=us21
# API Key (modo alternativo; NO cumple OAuth 2.0)
MAILCHIMP_API_KEY=<REEMPLAZAR_CON_MAILCHIMP_API_KEY>
MAILCHIMP_LIST_ID=<REEMPLAZAR_CON_ID_DE_LISTA_MAILCHIMP>

# -----------------------------------------------------------------------------
# INTEGRACIÓN: CALENDLY
# Modo de autenticación: 'oauth2' (OAuth 2.1 de Calendly) | 'pat'
# -----------------------------------------------------------------------------
CALENDLY_AUTH_MODE=pat
# Token emitido por una app OAuth 2.1 de Calendly (PKCE, consentimiento del usuario)
CALENDLY_ACCESS_TOKEN=<REEMPLAZAR_CON_OAUTH_21_ACCESS_TOKEN>
# Personal Access Token (modo por defecto de Calendly para apps internas)
CALENDLY_API_TOKEN=<REEMPLAZAR_CON_PERSONAL_ACCESS_TOKEN>
CALENDLY_WEBHOOK_SIGNING_KEY=<REEMPLAZAR_CON_WEBHOOK_SIGNING_KEY>
CALENDLY_WEBHOOK_SECRET=<REEMPLAZAR_CON_WEBHOOK_SIGNING_KEY>
CALENDLY_ORG_URI=<REEMPLAZAR_CON_ORG_URI_DE_CALENDLY>

# -----------------------------------------------------------------------------
# INTEGRACIÓN: MICROSOFT 365 / ONEDRIVE / EXCEL (Azure AD App Registration)
# OAuth 2.0 Client Credentials — se mantiene sin cambios
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=<REEMPLAZAR_CON_CLIENT_ID>
MICROSOFT_CLIENT_SECRET=<REEMPLAZAR_CON_CLIENT_SECRET>
MICROSOFT_TENANT_ID=<REEMPLAZAR_CON_TENANT_ID>

# -----------------------------------------------------------------------------
# SERVICIOS INTERNOS (API keys para n8n → servicios HTTP de la red interna)
# -----------------------------------------------------------------------------
RECONCILER_API_KEY=<REEMPLAZAR_CON_API_KEY_INTERNA>
METRICS_API_KEY=<REEMPLAZAR_CON_API_KEY_INTERNA>
DASHBOARD_API_KEY=<REEMPLAZAR_CON_API_KEY_INTERNA>
PORT=3000

# -----------------------------------------------------------------------------
# COMPONENTE DE MÉTRICAS (VD1/VD2) — línea base del proceso manual
# IMPORTANTE: estos valores deben sustituirse por la medición REAL del proceso
# manual del piloto. Los valores por defecto son marcadores de posición, no evidencia.
# -----------------------------------------------------------------------------
METRICS_LINEA_BASE_TIEMPO_SEGUNDOS=120
METRICS_LINEA_BASE_TASA_ERROR_PORCENTAJE=5
METRICS_UMBRAL_OBSERVACIONES=30

# -----------------------------------------------------------------------------
# DASHBOARD EJECUTIVO (§4.4)
# DASHBOARD_EXCEL_DRIVE_ITEM_ID: ID del libro Excel en OneDrive (Graph Explorer:
# GET https://graph.microsoft.com/v1.0/me/drive/root:/Dashboard.xlsx → id)
# -----------------------------------------------------------------------------
DASHBOARD_EXCEL_DRIVE_ITEM_ID=<REEMPLAZAR_CON_DRIVE_ITEM_ID>
DASHBOARD_EXCEL_WORKSHEET=Dashboard Ejecutivo
DASHBOARD_PERIODO_HORAS=168

# -----------------------------------------------------------------------------
# TRAEFIK DASHBOARD
# -----------------------------------------------------------------------------
TRAEFIK_DASHBOARD_CREDENTIALS=<REEMPLAZAR_CON_HASH_BCRYPT>
