# =============================================================================
# .env.example — Variables de entorno para n8n Fintech Colombia
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena TODOS los valores marcados con <REEMPLAZAR>
#   3. Asegúrate de que .env esté en tu .gitignore (NUNCA subir al repositorio)
#   4. Permisos del archivo: chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# DOMINIO
# -----------------------------------------------------------------------------
# Dominio apuntando al VPS (registro A en tu DNS)
DOMAIN_NAME=n8n.tuempresa.com.co

# -----------------------------------------------------------------------------
# POSTGRESQL — Base de datos
# -----------------------------------------------------------------------------
POSTGRES_DB=n8n_fintech
POSTGRES_USER=n8n_user
# CRÍTICO: Usa una contraseña fuerte (mín. 32 chars, alfanumérico + especiales)
# Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=<REEMPLAZAR_CONTRASEÑA_POSTGRESQL>

# Rutas de volúmenes persistentes en el host del VPS
# Asegúrate de que estas rutas existan: mkdir -p /opt/n8n-fintech/{postgres,n8n,traefik/certs}
POSTGRES_DATA_PATH=/opt/n8n-fintech/postgres
N8N_DATA_PATH=/opt/n8n-fintech/n8n
TRAEFIK_CERTS_PATH=/opt/n8n-fintech/traefik/certs

# -----------------------------------------------------------------------------
# N8N — Configuración principal
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
# CRÍTICO: Usa una contraseña fuerte
N8N_BASIC_AUTH_PASSWORD=<REEMPLAZAR_CONTRASEÑA_N8N>

# CRÍTICO: Clave de cifrado para credenciales almacenadas en reposo (Ley 1581 - Art. 17)
# Genera con: openssl rand -hex 32
# ⚠️ Si pierdes esta clave, TODAS las credenciales guardadas en n8n se perderán.
# Guárdala en un gestor de secretos (ej: HashiCorp Vault, AWS Secrets Manager).
N8N_ENCRYPTION_KEY=<REEMPLAZAR_CLAVE_CIFRADO_32_CHARS>

# Días de retención de ejecuciones (mínimo recomendado por Ley 1581: según política de datos)
EXECUTIONS_DATA_MAX_AGE=90

# Número de flujos de trabajo ejecutándose simultáneamente
N8N_CONCURRENCY=5

# -----------------------------------------------------------------------------
# TRAEFIK — Reverse Proxy y TLS
# -----------------------------------------------------------------------------
# Email para notificaciones de Let's Encrypt (renovación de certificados)
LETSENCRYPT_EMAIL=devops@tuempresa.com.co

# Credenciales del dashboard de Traefik (formato htpasswd)
# Genera con: htpasswd -nB admin  (o instala apache2-utils)
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$2y$$05$$REEMPLAZAR_HASH_BCRYPT

# (Opcional) Si usas Cloudflare DNS Challenge para TLS wildcard:
# CF_DNS_API_TOKEN=<TOKEN_CLOUDFLARE>

# -----------------------------------------------------------------------------
# SMTP — Notificaciones de sistema n8n
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tuempresa.com.co
SMTP_PASS=<REEMPLAZAR_CONTRASEÑA_APP_SMTP>
SMTP_SENDER=n8n-fintech@tuempresa.com.co

# -----------------------------------------------------------------------------
# INTEGRACIÓN: HUBSPOT CRM
# Documentación: https://developers.hubspot.com/docs/api/overview
# Obtener API Key: https://app.hubspot.com/api-key/<PORTAL_ID>
# -----------------------------------------------------------------------------
HUBSPOT_API_KEY=<REEMPLAZAR_HUBSPOT_API_KEY>
HUBSPOT_PORTAL_ID=<REEMPLAZAR_HUBSPOT_PORTAL_ID>

# -----------------------------------------------------------------------------
# INTEGRACIÓN: MAILCHIMP
# Documentación: https://mailchimp.com/developer/marketing/docs/fundamentals/
# Obtener API Key: https://us1.admin.mailchimp.com/account/api/
# Server Prefix: los primeros caracteres después de "-" en tu API key (ej: us21)
# -----------------------------------------------------------------------------
MAILCHIMP_API_KEY=<REEMPLAZAR_MAILCHIMP_API_KEY>
MAILCHIMP_SERVER_PREFIX=us21

# -----------------------------------------------------------------------------
# INTEGRACIÓN: CALENDLY
# Documentación: https://developer.calendly.com/
# Personal Access Token: https://calendly.com/integrations/api_webhooks
# -----------------------------------------------------------------------------
CALENDLY_API_KEY=<REEMPLAZAR_CALENDLY_PERSONAL_ACCESS_TOKEN>
CALENDLY_WEBHOOK_SIGNING_KEY=<REEMPLAZAR_CALENDLY_WEBHOOK_SIGNING_KEY>
# URI de tu organización: https://api.calendly.com/users/me → obtén organization URI
CALENDLY_ORG_URI=https://api.calendly.com/organizations/<REEMPLAZAR_ORG_UUID>

# -----------------------------------------------------------------------------
# INTEGRACIÓN: MICROSOFT 365 / ONEDRIVE / EXCEL
# Documentación: https://learn.microsoft.com/en-us/graph/overview
# Registro de aplicación: https://portal.azure.com → Azure Active Directory → App registrations
# Permisos requeridos en Azure AD:
#   - Files.ReadWrite.All (OneDrive/Excel)
#   - Sites.ReadWrite.All (SharePoint)
#   - Mail.Send (opcional, notificaciones)
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=<REEMPLAZAR_AZURE_APP_CLIENT_ID>
MICROSOFT_CLIENT_SECRET=<REEMPLAZAR_AZURE_APP_CLIENT_SECRET>
MICROSOFT_TENANT_ID=<REEMPLAZAR_AZURE_TENANT_ID>
