{
  "name": "excel-reconciler",
  "version": "1.0.0",
  "description": "Servicio de conciliación financiera entre n8n y Excel/OneDrive via Microsoft Graph API",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:server": "node src/server.js",
    "dev": "node --watch src/index.js",
    "dev:server": "node --watch src/server.js",
    "test": "node --test src/__tests__/reconciler.test.js src/__tests__/server.test.js",
    "lint": "node --check src/**/*.js"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "decimal.js": "^10.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5"
  },
  "keywords": [
    "fintech",
    "excel",
    "microsoft-graph",
    "n8n",
    "reconciliation",
    "investment"
  ],
  "author": "Tesis Automatización Fintech — Colombia",
  "license": "MIT"
}
