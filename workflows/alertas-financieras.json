    {
      "parameters": {
        "from": "={{ $env.SMTP_SENDER || 'alertas@ejemplo.co' }}",
        "to": "={{ $env.ADMIN_EMAIL || 'REEMPLAZAR_ADMIN_EMAIL' }}",
        "subject": "Error en workflow Alertas Financieras — n8n Fintech",
        "emailFormat": "text",
        "text": "={{ 'Workflow: alertas-financieras\nError: ' + $json.error.message + '\nTimestamp: ' + $now.toISOString() }}",
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000008",
      "name": "Email Alerta Error HTTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, 840],
      "credentials": {
        "smtp": {
          "id": "CONFIGURAR",
          "name": "SMTP n8n Fintech"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "purpose": "Consulta el endpoint HTTP del excel-reconciler (POST /reconcile), evalúa el campo status de la respuesta, registra en automation_log (exito/advertencia/error) y envía email al administrador si hay discrepancias o fallos. Ejecuta por schedule (cron). Cubre RF-008, RF-009, RF-010."
        },
        "options": {}
      },
