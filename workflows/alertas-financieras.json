{
  "name": "Alertas Financieras",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "interval": 1
            }
          ]
        },
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000001",
      "name": "Schedule Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://excel-reconciler:3000/reconcile",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "c0a10004-0000-4000-8000-000000000002",
      "name": "HTTP Request Reconciliación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "Reconciler API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c0a10004-0000-4000-8000-0000000000b1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "COINCIDE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000003",
      "name": "Evaluar Status Conciliación",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "automation_log",
        "columns": {
          "workflow_id": "alertas-financieras",
          "timestamp_inicio": "={{ $now.toISOString() }}",
          "estado": "exito",
          "registros_procesados": "={{ $json.resumen.total }}",
          "latencia_ms": null,
          "mensaje_error": null
        },
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000004",
      "name": "Log Éxito Coincide",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [720, -120],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "automation_log",
        "columns": {
          "workflow_id": "alertas-financieras",
          "timestamp_inicio": "={{ $now.toISOString() }}",
          "estado": "advertencia",
          "registros_procesados": "={{ $json.resumen.total }}",
          "latencia_ms": null,
          "mensaje_error": "={{ JSON.stringify($json.resultados) }}"
        },
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000005",
      "name": "Log Advertencia Discrepancia",
