      "typeVersion": 2,
      "position": [720, 120],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "from": "={{ $env.SMTP_SENDER || 'alertas@ejemplo.co' }}",
        "to": "={{ $env.ADMIN_EMAIL || 'REEMPLAZAR_ADMIN_EMAIL' }}",
        "subject": "Alerta: Discrepancias en conciliación financiera — n8n Fintech",
        "emailFormat": "text",
        "text": "={{ 'Workflow: alertas-financieras\nSe detectaron discrepancias en la conciliación.\nResumen: ' + JSON.stringify($json.resumen) + '\nDetalle: ' + JSON.stringify($json.resultados) + '\nTimestamp: ' + $now.toISOString() }}",
        "options": {}
      },
      "id": "c0a10004-0000-4000-8000-000000000006",
      "name": "Email Alerta Discrepancias",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, 360],
      "credentials": {
        "smtp": {
          "id": "CONFIGURAR",
          "name": "SMTP n8n Fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "automation_log",
        "columns": {
          "workflow_id": "alertas-financieras",
          "timestamp_inicio": "={{ $now.toISOString() }}",
          "timestamp_fin": "={{ $now.toISOString() }}",
          "estado": "error",
          "registros_procesados": 0,
          "latencia_ms": null,
          "mensaje_error": "={{ $json.error.message }}"
