      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  COALESCE((SELECT SUM(registros_procesados) FROM automation_log WHERE workflow_id = 'captura-leads' AND estado = 'exito' AND timestamp_inicio >= '{{ $now.clone().subtract(1, \"weeks\").startOf(\"week\").toISOString() }}' AND timestamp_inicio <= '{{ $now.clone().subtract(1, \"weeks\").endOf(\"week\").toISOString() }}'), 0) as contactos_procesados,\n  COALESCE((SELECT SUM(registros_procesados) FROM automation_log WHERE workflow_id = 'captura-leads' AND estado = 'exito' AND timestamp_inicio >= '{{ $now.clone().subtract(1, \"weeks\").startOf(\"week\").toISOString() }}' AND timestamp_inicio <= '{{ $now.clone().subtract(1, \"weeks\").endOf(\"week\").toISOString() }}'), 0) as citas_registradas,\n  COALESCE((SELECT COUNT(*) FROM lead WHERE estado = 'cliente' AND fecha_registro >= '{{ $now.clone().subtract(1, \"weeks\").startOf(\"week\").toISOString() }}' AND fecha_registro <= '{{ $now.clone().subtract(1, \"weeks\").endOf(\"week\").toISOString() }}'), 0) as negocios_cerrados,\n  COALESCE((SELECT COUNT(*) FROM automation_log WHERE estado = 'error' AND timestamp_inicio >= '{{ $now.clone().subtract(1, \"weeks\").startOf(\"week\").toISOString() }}' AND timestamp_inicio <= '{{ $now.clone().subtract(1, \"weeks\").endOf(\"week\").toISOString() }}'), 0) as flujos_fallidos",
        "options": {}
      },
      "id": "c0a10005-0000-4000-8000-000000000004",
      "name": "Consultar Métricas Semana",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [720, -120],
