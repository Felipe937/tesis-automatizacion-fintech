    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as count FROM automation_log WHERE workflow_id = 'reporte-semanal' AND timestamp_inicio >= NOW() - INTERVAL '12 hours'",
        "options": {}
      },
      "id": "c0a10005-0000-4000-8000-000000000002",
