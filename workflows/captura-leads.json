{
  "name": "Captura Leads",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calendly-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000001",
      "name": "Webhook Calendly",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "c0a10002-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "operation": "validate",
        "validationType": "hmac",
        "hmacSecret": "={{ $credentials.calendlyWebhookSecret }}",
        "headerName": "X-Calendly-Signature",
        "payloadSource": "body"
      },
      "id": "c0a10002-0000-4000-8000-000000000002",
      "name": "Validar HMAC Calendly",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "get",
        "resource": "contact",
        "email": "={{ $json.payload.event.invitee.email }}",
        "additionalFields": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000003",
      "name": "Buscar Contacto HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "resource": "contact",
        "contactId": "={{ $json.results[0].id }}",
        "properties": {
          "estado": "cita_pendiente"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000004",
      "name": "Actualizar Contacto HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "contact",
        "properties": {
          "firstname": "={{ $json.payload.event.invitee.first_name }}",
          "lastname": "={{ $json.payload.event.invitee.last_name }}",
          "email": "={{ $json.payload.event.invitee.email }}",
          "phone": "={{ $json.payload.event.invitee.phone_number }}",
          "estado": "nuevo"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000005",
      "name": "Crear Contacto HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "lead",
        "columns": {
          "nombre": "={{ $json.contact.properties.firstname }} ' ' $json.contact.properties.lastname }}",
          "correo_electronico": "={{ $json.contact.properties.email }}",
          "telefono": "={{ $json.contact.properties.phone }}",
          "estado": "nuevo",
          "id_hubspot": "={{ $json.contact.id }}"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000006",
      "name": "Insertar Lead en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [960, 0],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "appointment",
        "columns": {
          "id_lead": "={{ $json.lastInsertId }}",
          "fecha_hora_inicio": "={{ $json.payload.event.invitee.event.start_time }}",
          "fecha_hora_fin": "={{ $json.payload.event.invitee.event.end_time }}",
          "enlace_calendly": "={{ $json.payload.event.invitee.event.uri }}",
          "estado": "pendiente"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000007",
      "name": "Insertar Appointment en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [960, 120],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "createOrUpdate",
        "resource": "listMember",
        "listId": "={{ $credentials.mailchimpListId }}",
        "emailAddress": "={{ $json.payload.event.invitee.email }}",
        "mergeFields": {
          "FNAME": "={{ $json.payload.event.invitee.first_name }}",
          "LNAME": "={{ $json.payload.event.invitee.last_name }}",
          "PHONE": "={{ $json.payload.event.invitee.phone_number }}"
        },
        "status": "subscribed",
        "tags": ["nuevo"],
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000008",
      "name": "Suscriptor Mailchimp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "Mailchimp API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "automation_log",
        "columns": {
          "workflow_id": "captura-leads",
          "timestamp_inicio": "={{ $now.toISOString() }}",
          "estado": "exito",
          "registros_procesados": 1,
          "latencia_ms": "={{ Date.now() - $json.startTime }}",
          "mensaje_error": null
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000009",
      "name": "Log Éxito AutomationLog",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1440, 0],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "automation_log",
        "columns": {
          "workflow_id": "captura-leads",
          "timestamp_inicio": "={{ $now.toISOString() }}",
          "timestamp_fin": "={{ $now.toISOString() }}",
          "estado": "error",
          "registros_procesados": 0,
          "latencia_ms": null,
          "mensaje_error": "={{ $json.error.message }}"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000010",
      "name": "Log Error AutomationLog",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1440, 240],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR",
          "name": "PostgreSQL n8n_fintech"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "to": "={{ $credentials.adminEmail }}",
        "subject": "Error en workflow Captura Leads — n8n Fintech",
        "text": "={{ 'Workflow: captura-leads\nError: ' + $json.error.message + '\nTimestamp: ' + $now.toISOString() }}",
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000011",
      "name": "Email Alerta Administrador",
      "type": "n8n-nodes-base.gmailSend",
      "typeVersion": 2,
      "position": [1440, 360],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURAR",
          "name": "Gmail/SMTP Admin"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "startTime": "={{ Date.now() }}",
          "purpose": "Captura leads desde Calendly webhook, sincroniza con HubSpot y Mailchimp, registra en PostgreSQL (lead + appointment) y traza en automation_log. Cubre RF-001 a RF-005."
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000012",
      "name": "Anotación Propósito",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1440, 480]
    },
    {
      "parameters": {
        "values": {
          "nombre": "Juan Pérez",
          "correo_electronico": "juan.perez@ejemplo.com.co",
          "telefono": "+57 300 123 4567",
          "estado": "nuevo"
        },
        "options": {}
      },
      "id": "c0a10002-0000-4000-8000-000000000013",
      "name": "Datos Sintéticos Prueba",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1440, 600]
    }
  ],
  "connections": {
    "Webhook Calendly": {
      "main": [
        [
          {
            "node": "Validar HMAC Calendly",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar HMAC Calendly": {
      "main": [
        [
          {
            "node": "Buscar Contacto HubSpot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Contacto HubSpot": {
      "main": [
        [
          {
            "node": "Actualizar Contacto HubSpot",
            "type": "main",
            "index": 0
          },
          {
            "node": "Crear Contacto HubSpot",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Actualizar Contacto HubSpot": {
      "main": [
        [
          {
            "node": "Insertar Lead en PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear Contacto HubSpot": {
      "main": [
        [
          {
            "node": "Insertar Lead en PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insertar Lead en PostgreSQL": {
      "main": [
        [
          {
            "node": "Insertar Appointment en PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insertar Appointment en PostgreSQL": {
      "main": [
        [
          {
            "node": "Suscriptor Mailchimp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Suscriptor Mailchimp": {
      "main": [
        [
          {
            "node": "Log Éxito AutomationLog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Éxito AutomationLog": {
      "main": [
        [
          {
            "node": "Anotación Propósito",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error AutomationLog": {
      "main": [
        [
          {
            "node": "Email Alerta Administrador",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Alerta Administrador": {
      "main": [
        [
          {
            "node": "Anotación Propósito",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Datos Sintéticos Prueba": {
      "main": [
        [
          {
            "node": "Anotación Propósito",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}